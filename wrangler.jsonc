// Cloudflare deployment: `npx wrangler deploy` publishes this folder to ebrahimvandi.com.
{
  "name": "ebrahimvandi",
  "main": "_cloudflare/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "ebrahimvandi.com", "custom_domain": true },
    { "pattern": "www.ebrahimvandi.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
